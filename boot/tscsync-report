#!/usr/bin/bash
# SPDX-License-Identifier: MIT
# Runs once per boot from tscsync-report.service (as root): clears the GRUB
# hang guard now that Linux is up, and records what tscsync.efi did.
set -u

# shellcheck source=/dev/null
. /etc/tscsync.conf
VAR=/sys/firmware/efi/efivars/TscSyncResult-950a48f2-b67d-4798-a024-88b7bf386000
OUT=/run/tscsync-result.txt

if "$EDITENV" "$GRUBENV" list 2>/dev/null | grep -qx 'tscsync_pending=1'; then
	"$EDITENV" "$GRUBENV" set tscsync_pending=0
fi

{
	if [ -r "$VAR" ]; then
		# efivarfs prefixes 4 bytes of attributes; the text is UTF-16LE.
		python3 -c 'import sys; d = open(sys.argv[1], "rb").read()[4:]; print(d.decode("utf-16-le").rstrip("\x00").rstrip())' "$VAR"
	else
		echo "tscsync.efi did not run on this boot"
	fi
	echo "clocksource: $(cat /sys/devices/system/clocksource/clocksource0/current_clocksource)"
} >"$OUT"
chmod 0644 "$OUT"
cat "$OUT"
